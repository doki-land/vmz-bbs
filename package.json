{
    "private": true,
    "workspaces": [
        "projects/vmz-bbs",
        "projects/vmz-official"
    ],
    "scripts": {
        "doc": "cargo doc --no-deps --all-features",
        "test": "cargo test --release",
        "fmt": "cargo fmt --all",
        "dev:official": "pnpm -F vmz-official dev",
        "dev:official:pages": "pnpm -F vmz-official dev:pages",
        "build:official:pages": "pnpm -F vmz-official build:pages",
        "build:official:worker": "pnpm -F vmz-official build:worker",
        "build:official": "pnpm -F vmz-official build",
        "deploy:official:worker": "pnpm -F vmz-official deploy:worker",
        "deploy:official:pages": "pnpm -F vmz-official deploy:pages",
        "deploy:official": "pnpm -F vmz-official deploy",
        "generate:official": "pnpm -F vmz-official generate",
        "push:official:plan": "pnpm -F vmz-official push:plan",
        "push:official": "pnpm -F vmz-official push",
        "p": "git push && git push --tags --prune",
        "reset": "git reset Head~ --soft",
        "u": "cargo upgrade --workspace"
    },
    "packageManager": "pnpm@9.15.0"
}
