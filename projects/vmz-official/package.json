{
    "name": "vmz-official",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "generate": "node --experimental-strip-types ./node_modules/@yydb/iris/bin/iris.mjs generate --config .",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "db:migrate:local": "wrangler d1 migrations apply vmz-official --local",
        "db:migrate:remote": "wrangler d1 migrations apply vmz-official --remote",
        "cf:types": "wrangler types"
    },
    "dependencies": {
        "@vmz/bbs": "workspace:*",
        "@yydb/iris": "workspace:*"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20250317.0",
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3",
        "wrangler": "^4.24.0"
    }
}
