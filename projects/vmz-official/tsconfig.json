{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "lib": ["ES2022"],
        "types": ["@cloudflare/workers-types"],
        "baseUrl": ".",
        "paths": {
            "@yydb/iris/types": ["../../../iris-orm/projects/iris.ts/packages/iris/src/types/index.ts"],
            "@iris/*": ["./generated/iris/*"]
        }
    },
    "include": ["src/**/*.ts", "worker.ts", "generated/**/*.ts", "iris.config.ts"],
    "exclude": ["generated/iris/node.ts", "generated/iris/browser.ts"]
}
